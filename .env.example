# OpenAI-compatible chat / multimodal model.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_with_your_key
LLM_MODEL_NAME=gpt-4o
LLM_MAX_TOKENS=8192

# Use Responses API style instead of LangChain chat-completions style.
# LLM_API_STYLE=responses

# Optional: force JSON-schema prompt fallback for providers without native structured output.
# LLM_FORCE_JSON_PROMPT=1

# Optional: Tavily web search for context completion and image search.
# TAVILY_API_KEY=replace_with_your_tavily_key

# Optional: external image generation API for visual prior strategy="api".
# AUTOVISUALSKILL_IMAGE_API_BASE_URL=https://your-provider.example/v1
# AUTOVISUALSKILL_IMAGE_API_KEY=replace_with_your_image_api_key
# AUTOVISUALSKILL_IMAGE_API_MODEL=gpt-image-2

# Optional: external subagent backend for offline/mock tests or custom LLM runtimes.
# AUTOVISUALSKILL_LLM_BACKEND=subagent
# AUTOVISUALSKILL_SUBAGENT_CMD="python tools/mock_subagent_backend.py"
